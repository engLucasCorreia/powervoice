desc:PowerVoice Test Gain with state
// @version 1.2.3
author:PowerVoice
tags:utility
slider1:0<-60,24,0.1>Gain (dB)
slider2:0<0,1000,1>Restores
in_pin:mono
out_pin:mono
import lib/gain_core.jsfx-inc

@init
ext_nodenorm = 1;
pv_gain_reset(slider1);

@slider
pv_gain_set(slider1);

@serialize
// Written: a marker and the restore count. Read back: the count goes up by one and shows on
// slider2, so a test sees that the script's own restore ran.
marker = 1234.5;
file_var(0, marker);
file_var(0, restores);
file_avail(0) >= 0 ? (
  restores += 1;
  slider2 = restores;
);

@sample
spl0 = spl0 * pv_gain_next();
